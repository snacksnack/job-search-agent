<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily launchd schedule for the deterministic pipeline (RC1-282).
     Rendered by ops/install-pipeline-schedule.sh — {{REPO}} and {{PYTHON}} are
     substituted at install time; edit the rendered copy in
     ~/Library/LaunchAgents/, not this template, for machine-local tweaks. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jobboard.pipeline</string>

  <!-- launchd agents get no shell environment; a login zsh sources ~/.zshenv,
       which is where ADZUNA_APP_ID / ADZUNA_APP_KEY live. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec {{PYTHON}} {{REPO}}/scripts/pipeline.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>{{REPO}}</string>

  <!-- Fire daily at 07:00 local time. If the Mac is asleep at 07:00, launchd
       runs the job at next wake (unlike cron, which would skip it). RunAtLoad
       stays off so installing or logging in never triggers a surprise sweep. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>{{REPO}}/data/logs/pipeline.log</string>
  <key>StandardErrorPath</key>
  <string>{{REPO}}/data/logs/pipeline.log</string>
</dict>
</plist>
